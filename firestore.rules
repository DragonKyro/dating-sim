rules_version = '2';

// Firestore in the shared project github-games-e7c7d. This file is the
// project's WHOLE rule set: deploying it replaces every rule, so it must keep
// every app's block. It is kept identical in Bridge-Master/firestore.rules,
// BlackJack/firestore.rules, Poker/firestore.rules and dating-sim/firestore.rules
// — change all four, then deploy from any one of them (npm run deploy:rules,
// or `firebase deploy --only firestore:rules` from dating-sim).
service cloud.firestore {
  match /databases/{database}/documents {
    // Bridge Master progress: one document per signed-in user, readable and
    // writable only by that user. { deals: { "1A-7": { b, t, at } }, updated }
    match /bridgeMaster/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['deals', 'updated'])
        && request.resource.data.deals is map;
    }

    // Blackjack Trainer: one document per signed-in user, readable, writable
    // and deletable only by that user (see BlackJack/src/net/cloud.ts).
    //   drills:   { id: "ts|mode|type|row|up|your|answer|tc" }  strategy decisions
    //   sessions: { id: "<json>" }                             counting / bet / smart / play sessions
    //   play:     { bankroll, at, ... }                         the Play table's bankroll
    //   spread:   { units, at }                                 the saved bet spread
    //   cleared:  ms                                            stats cleared before this time
    match /blackjack/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['drills', 'sessions', 'play', 'spread', 'cleared', 'updated'])
        && (!('drills' in request.resource.data) || request.resource.data.drills is map)
        && (!('sessions' in request.resource.data) || request.resource.data.sessions is map)
        && (!('play' in request.resource.data) || request.resource.data.play is map)
        && (!('spread' in request.resource.data) || request.resource.data.spread is map)
        && (!('cleared' in request.resource.data) || request.resource.data.cleared is number);
    }

    // Poker Trainer progress: one document per signed-in user, readable and
    // writable only by that user. Each device writes only its own entry, so
    // counters merge without conflicts:
    // { devices: { "<deviceId>": { spots, days, misses, at } }, updated }
    match /pokerTrainer/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['devices', 'updated'])
        && request.resource.data.devices is map;
    }

    // Last Ferry (dating-sim) cloud save: one document per signed-in player,
    // readable, writable and deletable only by that player
    // (see dating-sim/js/cloud.js). The API key never leaves the device.
    //   save:    map   game progress (characters, levels, flags, settings)
    //   version: int   save schema version
    //   updated: ms    last write time
    match /datingSim/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'version', 'updated'])
        && request.resource.data.save is map
        && request.resource.data.version is number
        && request.resource.data.updated is number;
    }
  }
}
